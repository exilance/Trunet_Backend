  "item": [
    {
      "name": "1. Admin - Credential Management (Bearer Token)",
      "description": "These endpoints require JWT Bearer token authentication (Super Admin only)",
      "item": [
        {
          "name": "Generate API Credentials",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Gandhi TVS Institute Client\",\n  \"instituteName\": \"Gandhi TVS Dealership\",\n  \"linkedUserId\": \"69e0e43796bbc07d5fd11fe1\",\n  \"description\": \"External API access for reporting and booking data\",\n  \"contactEmail\": \"admin@gandhitvs.in\",\n  \"contactPhone\": \"9876543210\",\n  \"purpose\": \"Data sync for institute management system\",\n  \"expiresAt\": \"2026-12-31T23:59:59.000Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/institute/generate-credentials",
              "host": ["{{base_url}}"],
              "path": ["institute", "generate-credentials"]
            },
            "description": "Generate new API key + secret for an institutional user.\n\n⚠️ Save the returned `apiSecret` — it will NOT be shown again."
          },
          "response": []
        },
        {
          "name": "List All API Clients",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/institute/clients",
              "host": ["{{base_url}}"],
              "path": ["institute", "clients"]
            },
            "description": "List all API clients. `apiSecret` is NOT returned for security."
          },
          "response": []
        },
        {
          "name": "Revoke API Credentials",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/institute/clients/{{client_id}}/revoke",
              "host": ["{{base_url}}"],
              "path": ["institute", "clients", "{{client_id}}", "revoke"]
            },
            "description": "Revoke (deactivate) API credentials for a specific client."
          },
          "response": []
        },
        {
          "name": "Regenerate API Credentials",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/institute/clients/{{client_id}}/regenerate",
              "host": ["{{base_url}}"],
              "path": ["institute", "clients", "{{client_id}}", "regenerate"]
            },
            "description": "Regenerate a new API key + secret. Old credentials stop working immediately."
          },
          "response": []
        }
      ]
    },
